{
  "name": "royalsmarine-backend",
  "version": "1.0.0",
  "description": "High-performance REST API backend for Royals Marine Aquafeed Management System",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "echo \"Backend build complete\"",
    "dev": "node --watch server.js",
    "db:view": "node scripts/viewTables.js",
    "db:wipe": "node scripts/wipeDatabase.js",
    "db:reset": "node scripts/wipeDatabase.js --reset",
    "db:drop": "node scripts/wipeDatabase.js --drop",
    "test": "node --test"
  },
  "keywords": [
    "aquaculture",
    "express",
    "api",
    "royalsmarine"
  ],
  "author": "Royals Marine Food Private Limited",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0"
  }
}
